.main-menu {
    width: 100%;
    height: 100%;
    background-color: rgb(8, 8, 10);
}

/* Swap this for your gotham/alley key art. Keep it desaturated so the gold pops. */
.background {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0.5;
}

/* Fakes a gradient using a soft radial/linear PNG asset, since USS has no gradient support.
   A simple black-to-transparent PNG stretched full-screen does the job. */
.vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/_StreetFight/Art/Images/Batman.png?fileID=2800000&guid=YOUR_GUID&type=3#Batman");
    background-color: rgb(0, 0, 0);
}

/* Oversized, faint bat emblem bleeding off the right edge — classic poster-style watermark */
.bat-watermark {
    position: absolute;
    right: -120px;
    top: -80px;
    width: 700px;
    height: 700px;
    opacity: 0.06;
    /* background-image: resource("Icons/bat_symbol"); */
}

.menu-container {
    position: absolute;
    left: 100px;
    top: 100px;
    width: 520px;
}

/* Thin gold bar behind the title, offset like a printed poster accent */
.title-accent {
    width: 70px;
    height: 4px;
    background-color: rgb(163, 163, 163);
    margin-bottom: 14px;
}

.game-title {
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    letter-spacing: 1px;
}

.subtitle {
    margin-top: 6px;
    font-size: 14px;
    color: rgb(163, 163, 163);
    letter-spacing: 4px;
    -unity-font-style: bold;
}

.buttons {
    width: 380px;
    margin-top: 60px;
}

.menu-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.row-index {
    width: 30px;
    font-size: 13px;
    color: rgb(90, 90, 95);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.menu-button {
    flex-grow: 1;
    height: 52px;

    background-color: rgb(22, 22, 25);
    border-left-width: 3px;
    border-left-color: rgb(45, 45, 50);
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;

    color: rgb(200, 200, 200);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    padding-left: 20px;

    transition-property: background-color, border-left-color, scale, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.menu-button:hover {
    background-color: rgb(35, 35, 38);
    border-left-color: rgb(163, 163, 163);
    color: rgb(255, 255, 255);
    scale: 1.02 1;
}

.menu-button:focus {
    border-left-width: 5px;
    border-left-color: rgb(163, 163, 163);
    background-color: rgb(40, 40, 44);
    color: white;
}

.menu-button:active {
    scale: 0.98 1;
    background-color: rgb(15, 15, 17);
}

/* Quit gets a subtle red tint on hover so it reads as "exit," not just another option */
.quit-button:hover {
    border-left-color: rgb(200, 50, 50);
}

.version {
    position: absolute;
    right: 25px;
    bottom: 20px;
    font-size: 12px;
    color: rgb(80, 80, 85);
    letter-spacing: 1px;
}